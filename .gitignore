# Built by pipeline/fetch.py on every deploy (GitHub Actions); never committed
data/

# Environment variables (never commit real credentials)
.env

# Python cache
__pycache__/
*.pyc
*.pyo

# Virtual environments
venv/
env/
.venv/

# OS / editor files
.DS_Store
Thumbs.db

# Local Flask app databases (user data at runtime; never commit)
server/database/*.db

# generated by pipeline/pages.py during deploy
stock/
sitemap.xml
robots.txt

# Local secrets: never commit
API Keys passwords/
*secret*
*.env
.env*
